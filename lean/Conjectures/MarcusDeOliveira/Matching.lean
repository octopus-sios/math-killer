import Mathlib.Data.Real.Basic
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Positivity
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.FinCases

/-! Positive coefficient arithmetic for the interlacing moment curve.
The checker is proved correct under evaluation, not run as an external oracle. -/
noncomputable section
namespace MOCMatching

def P : Nat → Type
  | 0 => Nat
  | n+1 => List (P n)

instance (k : Nat) : OfNat (P 0) k := ⟨k⟩

def zeroP : (n : Nat) → P n
  | 0 => 0
  | _+1 => []

def oneP : (n : Nat) → P n
  | 0 => 1
  | n+1 => [oneP n]

def zipAdd {α : Type} (f : α → α → α) : List α → List α → List α
  | [],q => q
  | p,[] => p
  | a::p,b::q => f a b :: zipAdd f p q

def addP : (n : Nat) → P n → P n → P n
  | 0 => Nat.add
  | n+1 => zipAdd (addP n)

def shift {α : Type} (z : α) : List α → List α
  | [] => []
  | a::p => z::a::p

def varMul : (n : Nat) → Nat → P n → P n
  | 0,_,_ => 0
  | n+1,0,p => shift (zeroP n) p
  | n+1,i+1,p => p.map (varMul n i)

def horner {α : Type} (f : α → ℝ) (x : ℝ) : List α → ℝ
  | [] => 0
  | a::p => f a + x * horner f x p

noncomputable def ev : (n : Nat) → P n → (Nat → ℝ) → ℝ
  | 0,p,_ => ((show Nat from p) : ℝ)
  | n+1,p,g => horner (fun a => ev n a (fun i => g (i+1))) (g 0) p

def restrict : Nat → (Nat → ℝ) → Nat → ℝ
  | 0,_,_ => 0
  | _+1,g,0 => g 0
  | n+1,g,i+1 => restrict n (fun j => g (j+1)) i

private theorem horner_add {α : Type} (f : α → ℝ) (x : ℝ) (op : α → α → α)
    (h : ∀ a b, f (op a b) = f a+f b) (p q : List α) :
    horner f x (zipAdd op p q) = horner f x p + horner f x q := by
  induction p generalizing q with
  | nil => simp [zipAdd,horner]
  | cons a p ih =>
    cases q <;> simp [zipAdd,horner,h,ih] <;> ring

private theorem horner_map {α : Type} (f : α → ℝ) (x c : ℝ) (op : α → α)
    (h : ∀ a, f (op a) = c*f a) (p : List α) :
    horner f x (p.map op) = c*horner f x p := by
  induction p <;> simp [horner,h, *] <;> ring

theorem ev_zero (n) (g) : ev n (zeroP n) g = 0 := by cases n <;> first | rfl | exact Nat.cast_zero

theorem ev_one (n) (g) : ev n (oneP n) g = 1 := by
  induction n generalizing g with
  | zero => exact Nat.cast_one
  | succ n ih => simp [ev,oneP,horner,ih]

theorem ev_add (n) (p q : P n) (g) : ev n (addP n p q) g = ev n p g + ev n q g := by
  induction n generalizing g with
  | zero => exact Nat.cast_add (p : Nat) (q : Nat)
  | succ n ih => exact horner_add _ _ _ (fun a b => ih _ _ _) p q

theorem ev_var (n i) (p : P n) (g) :
    ev n (varMul n i p) g = restrict n g i * ev n p g := by
  induction n generalizing i g with
  | zero => simp [ev,varMul,restrict] <;> first | exact Nat.cast_zero | rfl
  | succ n ih =>
    cases i with
    | zero => cases p <;> simp [varMul,ev,shift,horner,restrict,ev_zero]
    | succ i => exact horner_map _ _ _ _ (fun a => ih i a _) p

theorem ev_nonneg (n) (p : P n) (g : Nat → ℝ) (hg : ∀ i, 0 ≤ g i) : 0 ≤ ev n p g := by
  induction n generalizing g with
  | zero => exact Nat.cast_nonneg (p : Nat)
  | succ n ih =>
    change 0 ≤ horner _ _ (p : List (P n))
    induction (p : List (P n)) with
    | nil => exact le_rfl
    | cons a q hq => exact add_nonneg (ih a _ (fun i => hg (i+1))) (mul_nonneg (hg 0) hq)

def total (n : Nat) : List (P n) → P n
  | [] => zeroP n
  | a::p => addP n a (total n p)

theorem ev_total (n) (p : List (P n)) (g) :
    ev n (total n p) g = (p.map (fun a => ev n a g)).sum := by
  induction p <;> simp [total,ev_add,ev_zero, *]

abbrev E := Nat × Nat
def gapVars (e : E) := (List.range 6).filter (fun i => decide (e.1 ≤ i ∧ i < e.2))
def timesGap (e : E) (p : P 6) := total 6 ((gapVars e).map (fun i => varMul 6 i p))
noncomputable def gap (e : E) (g : Nat → ℝ) := ((gapVars e).map (restrict 6 g)).sum

theorem ev_gap (e : E) (p : P 6) (g) : ev 6 (timesGap e p) g = gap e g * ev 6 p g := by
  unfold timesGap gap
  rw [ev_total,List.map_map]
  induction gapVars e with
  | nil => simp
  | cons i t ih => simp [ev_var,ih,add_mul]

def chords (s : Nat) : List E := (List.range 7).flatMap (fun a =>
  (((List.range 7).filter (fun b => decide (a<b) && (s.testBit a == s.testBit b))).map (a,·)))
def size (s : Nat) := ((List.range 8).filter (fun i => s.testBit i)).length

/-- The two Vandermonde minors multiplied together: skip every infinity
bracket, and include each pair of finite nodes with the same membership. -/
noncomputable def numerator (s : Nat) (g : Nat → ℝ) : ℝ :=
  ((chords s).map (gap · g)).prod

def compiled (s : Nat) : P 6 := (chords s).foldr timesGap (oneP 6)

theorem ev_compiled (s : Nat) (g) : ev 6 (compiled s) g = numerator s g := by
  unfold compiled numerator
  induction chords s <;> simp [ev_gap,ev_one, *]

def compatible (s : Nat) (m : List E) := m.all (fun (a,b) => s.testBit a != s.testBit b)


