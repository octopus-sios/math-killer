def selected (s : Nat) := (terms.filter (fun t => compatible s t.1)).map Prod.snd

/-- Every listed support element really is a perfect noncrossing matching
with alternating row/column colors. -/
def perfectNC (m : List E) : Bool :=
  (List.range 8).all (fun x => (m.filter (fun e => e.1==x || e.2==x)).length == 1) &&
  m.all (fun e => decide (e.1 < e.2 ∧ e.2 < 8) && (e.1%2 != e.2%2) &&
    m.all (fun f => !(decide (e.1 < f.1 ∧ f.1 < e.2 ∧ e.2 < f.2))))

theorem support_checked : terms.length = 14 ∧ (terms.map Prod.fst).Nodup ∧
    (terms.map Prod.fst).all perfectNC = true := by decide

