private theorem certificate (s : Fin 256) (hs : size s = 4) :
    compiled s = total 6 (selected s) := by
  have allMasks : ∀ s : Fin 256, size s = 4 → s ∈ ([15,23,27,29,30,39,43,45,46,51,53,54,57,58,60,71,75,77,78,83,85,86,89,90,92,99,101,102,105,106,108,113,114,116,120,135,139,141,142,147,149,150,153,154,156,163,165,166,169,170,172,177,178,180,184,195,197,198,201,202,204,209,210,212,216,225,226,228,232,240] : List (Fin 256)) := by decide
