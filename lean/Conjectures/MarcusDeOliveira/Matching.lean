theorem denom_pos (g : Nat → ℝ) (hg : ∀ i, 0 < g i) : 0 < numerator 170 g := by
  have he : numerator 170 g = ((g 0 + (g 1 + 0)) * ((g 0 + (g 1 + (g 2 + (g 3 + 0)))) * ((g 0 + (g 1 + (g 2 + (g 3 + (g 4 + (g 5 + 0)))))) * ((g 1 + (g 2 + 0)) * ((g 1 + (g 2 + (g 3 + (g 4 + 0)))) * ((g 2 + (g 3 + 0)) * ((g 2 + (g 3 + (g 4 + (g 5 + 0)))) * ((g 3 + (g 4 + 0)) * ((g 4 + (g 5 + 0)) * 1))))))))) := rfl
  rw [he]
  have h0 := hg 0
  have h1 := hg 1
  have h2 := hg 2
  have h3 := hg 3
  have h4 := hg 4
  have h5 := hg 5
  positivity

/-- A universal, kernel-checked gap-polynomial theorem: one coefficient
per matching, simultaneously for every one of the 70 four-subsets of the
alternating eight-node sequence (infinity last). No numerical samples. -/
theorem all_marginals (g : Nat → ℝ) (s : Fin 256) (hs : size s = 4) :
    numerator s g / numerator 170 g =
      ((selected s).map (fun p => ev 6 p g / numerator 170 g)).sum := by
  rw [← ev_compiled, certificate s hs, ev_total]
  induction selected s with
  | nil => simp
  | cons a l ih => simp [add_div,ih]

theorem positive_law (g : Nat → ℝ) (hg : ∀ i, 0 < g i) :
    (∀ p ∈ terms.map Prod.snd, 0 ≤ ev 6 p g / numerator 170 g) ∧
    ((terms.map Prod.snd).map (fun p => ev 6 p g / numerator 170 g)).sum = 1 := by
  refine ⟨fun p _ => div_nonneg (ev_nonneg 6 p g (fun i => (hg i).le)) (denom_pos g hg).le,?_⟩
  have h := all_marginals g 170 (by decide)
  have he : selected 170 = terms.map Prod.snd := rfl
  change numerator 170 g / numerator 170 g =
    ((selected 170).map (fun p => ev 6 p g / numerator 170 g)).sum at h
  rw [he, div_self (ne_of_gt (denom_pos g hg))] at h
  exact h.symm
end MOCMatching
